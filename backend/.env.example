# Cấu hình mẫu cho Backend FastAPI (Dành cho giai đoạn phát triển Backend)
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neuroscan_db

# Object Storage (Lưu ảnh MRI đã ẩn danh)
STORAGE_BUCKET=neuroscan-mri-private
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_TYPES=image/png,image/jpeg
